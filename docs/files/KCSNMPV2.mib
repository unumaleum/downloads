--
--   alarms objects
--
        systemAlarms OBJECT-TYPE
                SYNTAX INTEGER
                ACCESS read-only
                STATUS mandatory
                DESCRIPTION
                        "Alarms Status: This is a 4 byte and each bit represents an alarm. 
					
					0x00000001 - Low DC Volt Alarm
					0x00000002 - Power Module Fail
					0x00000004 - NA
					0x00000008 - PowerLvlIndicator       
					0x00000010 - Module Temperature Warning
					0x00000020 - Module Local Disable
					0x00000040 - cage comm failure detected
					0x00000080 - AB Bus Fail Detect
					0x00000100 - System Disable 
				    0x00000200 - Power Module fail detected
					0x00000400 - Slot Not Detected fault
					0x00000800 - Ph1 on Ref2
					0x00001000 - Ph1 on Ref2
					0x00002000 - Ph1 on Ref2
					0x00004000 - NA
					0x00008000 - NA
					0x00010000 - Utility Primary
					0x00020000 - Inverter source fault 
					0x00040000 - Utility source fault
					0x00080000 - MBS Lockout Asserted
					0x00100000 - Sources not sync
					0x00200000 - Fan fault detect STS PowerSwitch
                    0x00400000 - Warm Temp  STS PowerSwitch
                    0x00800000 - Overtemp 	STS PowerSwitch					
					0x01000000 - SCR Active  (Legacy)
					0x02000000 - Utility SCR Driving  
					0x04000000 - STS Backfeed protection enabled
					0x08000000 - Line 2 Line fail
					0x10000000 - STS Forced Inverter State
					0x20000000 - STS Forced Utility State
					0x40000000 - STS Forced Contactor Open
					0x80000000 - STS Contactor Open Detected"
					
                ::= { alarms 1 }
				
		slotAlarms OBJECT-TYPE
                SYNTAX INTEGER
                ACCESS read-only
                STATUS mandatory
                DESCRIPTION
                        "Alarms Status: This is a 4 byte and each bit represents a slot not communicating. 
					
					0x00000001 - Slot  1 not detected
					0x00000002 - Slot  2 not detected
					0x00000004 - Slot  3 not detected
					0x00000008 - Slot  4 not detected  
					0x00000010 - Slot  5 not detected
					0x00000020 - Slot  6 not detected
					0x00000040 - Slot  7 not detected
					0x00000080 - Slot  8 not detected
					0x00000100 - Slot  9 not detected
				    0x00000200 - Slot 10 not detected
					0x00000400 - Slot 11 not detected
					0x00000800 - n/a 
					0x00001000 - n/a 
					0x00002000 - n/a 
					0x00004000 - n/a 
					0x00008000 - n/a" 
				
                ::= { alarms 2 }
				
        alarmOne OBJECT-TYPE
                SYNTAX INTEGER
                ACCESS read-only
                STATUS mandatory
                DESCRIPTION
                        "Alarms Status: 0 is no Alarm, 1 is any configured Alarm 1 bit set with the corrisponding alarm 1 bit set."
                ::= { alarms 3 }

        alarmTwo OBJECT-TYPE
                SYNTAX INTEGER
                ACCESS read-only
                STATUS mandatory
                DESCRIPTION
                        "Alarms Status: 0 is no Alarm, 1 is any configured Alarm 2 bit set with the corrisponding alarm 2 bit set."
                ::= { alarms 4 }     
--
--   settings objects
--
        dCVLow OBJECT-TYPE
                SYNTAX INTEGER
                ACCESS read-write
                STATUS mandatory
                DESCRIPTION
                        "This value is the low DC Voltage limit for sending traps. The voltage 
					 needs to be set in deciVolts. Multiply the voltage by 10 and then send
					 that value."
                ::= { settings 1 }

        dCVHigh OBJECT-TYPE
                SYNTAX INTEGER
                ACCESS read-write
                STATUS mandatory
                DESCRIPTION
                        "This value is the high DC Voltage limit for sending traps. The voltage 
					 needs to be set in deciVolts. Multiply the voltage by 10 and then send
					 that value."
                ::= { settings 2 }
				
        alarm1Configuration OBJECT-TYPE
                SYNTAX INTEGER
                ACCESS read-only
                STATUS mandatory
                DESCRIPTION
                        "The Current internal bitstate configurations for Alarm 1 
					 Use ProductStatus to modify Configurations"
                ::= { settings 3 }
				
        alarm2Configuration OBJECT-TYPE
                SYNTAX INTEGER
                ACCESS read-only
                STATUS mandatory
                DESCRIPTION
                        "The Current internal bitstate configurations for Alarm 2 
					 Use ProductStatus to modify Configurations"
                ::= { settings 4 }
				
        slotConfiguration OBJECT-TYPE
                SYNTAX INTEGER
                ACCESS read-only
                STATUS mandatory
                DESCRIPTION
                        "The Current internal bitstate configurations for module slot alarms"
                ::= { settings 5 }

        trap-target-ip1 OBJECT-TYPE
                SYNTAX IpAddress
                ACCESS read-write
                STATUS mandatory
                DESCRIPTION
                        "Ip address of the first manager for traps. Set to zero to STOP TRAPS from sending"
                ::= { settings 6 }

        trap-target-ip2 OBJECT-TYPE
                SYNTAX IpAddress
                ACCESS read-write
                STATUS mandatory
                DESCRIPTION
                        "Ip address of the second manager for traps.  Set to zero to remove target"
                ::= { settings 7 }
				
        trap-target-ip3 OBJECT-TYPE
                SYNTAX IpAddress
                ACCESS read-write
                STATUS mandatory
                DESCRIPTION
                        "Ip address of the third manager for traps.  Set to zero to remove target"
                ::= { settings 8 }
				
        ipAddressStatic OBJECT-TYPE
                SYNTAX IpAddress
                ACCESS read-write
                STATUS mandatory
                DESCRIPTION
                        "The System static IP Address"
                ::= { settings 9 }

        subnetMaskStatic OBJECT-TYPE
                SYNTAX IpAddress
                ACCESS read-write
                STATUS mandatory
                DESCRIPTION
                        "The System IP subnet mask"
                ::= { settings 10 }

        defaultGatewayStatic OBJECT-TYPE
                SYNTAX IpAddress
                ACCESS read-write
                STATUS mandatory
                DESCRIPTION
                        "The System IP Gateway Address"
                ::= { settings 11 }
        setNetworkConfig OBJECT-TYPE
                SYNTAX INTEGER
                ACCESS read-write
                STATUS mandatory
                DESCRIPTION
                        "Integer value indicationg Static IP usage or DHCP usage, also any additional networking properties"
                ::= { settings 12 }
----------------------------------------------------------------------------------------------------------
        ntp-ip1 OBJECT-TYPE
                SYNTAX IpAddress
                ACCESS read-write
                STATUS mandatory
                DESCRIPTION
                        "Ip address of the SNTP server"
                ::= { settings 13 }
        ntp-set OBJECT-TYPE
                SYNTAX INTEGER
                ACCESS read-write
                STATUS mandatory
                DESCRIPTION
                        "Timezone settings For SNTP configuration"
                ::= { settings 14 }
        traps-config OBJECT-TYPE
                SYNTAX INTEGER
                ACCESS read-write
                STATUS mandatory
                DESCRIPTION
                        "configuration setting for the All-good traps, 0-255 where the period between All-good traps is 30 seconds*VALUE, zero is off"
                ::= { settings 15 }
        logging-config OBJECT-TYPE
                SYNTAX INTEGER
                ACCESS read-write
                STATUS mandatory
                DESCRIPTION
                        "configuration setting logging, factory use only"
                ::= { settings 16 }				
----------------------------------------------------------------------------------------------------
--
-- V1/V2 trap syntax
--	

	lowDCtrap  TRAP-TYPE
				ENTERPRISE batDCV 
				VARIABLES { batDCV, dCVLow }
				DESCRIPTION "Battery voltage low limit has been triggered."
	::=  1

	highDCtrap		TRAP-TYPE
				ENTERPRISE batDCV 
				VARIABLES { batDCV, dCVHigh }
				DESCRIPTION "Battery voltage high limit has been triggered."
	::=  2 

	 

	alarmConfig1trap		TRAP-TYPE
				ENTERPRISE alarms   				
				VARIABLES { alarm1Configuration, systemAlarms}
				DESCRIPTION "A minor alarm has been triggered."
	::=  3 

	alarmConfig2trap		TRAP-TYPE
				ENTERPRISE alarms 			
				VARIABLES  { alarm2Configuration, systemAlarms}
				DESCRIPTION "A major alarm has been triggered."
	::=  4 
	
	generalAlarmtrap		TRAP-TYPE
				ENTERPRISE alarms 			
				VARIABLES { alarmOne, alarmTwo }
				DESCRIPTION "A general Status update"
	::=  5
	slotAlarmtrap		TRAP-TYPE
				ENTERPRISE alarms 			
				VARIABLES { slotAlarms }
				DESCRIPTION "A general Status update"
	::=  6

--alarmOne
